{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G-Force workspace-files 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipeVersion", "profile", "appName", "referenceDate", "storage", "files"],
  "properties": {
    "recipeVersion": { "const": "1.1.0" },
    "profile": { "const": "workspace-files" },
    "appName": { "type": "string", "minLength": 1, "maxLength": 24 },
    "referenceDate": { "type": "string", "format": "date" },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["usedGB", "totalGB"],
      "properties": { "usedGB": { "type": "number", "minimum": 0 }, "totalGB": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "files": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "parentId", "name", "kind", "owner", "modified", "bytes", "shared", "starred", "trashed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
          "parentId": { "type": ["string", "null"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "kind": { "enum": ["folder", "document", "image", "pdf"] },
          "owner": { "type": "string", "minLength": 1, "maxLength": 40 },
          "modified": { "type": "string", "format": "date" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "shared": { "type": "boolean" }, "starred": { "type": "boolean" }, "trashed": { "type": "boolean" }
        }
      }
    }
  },
  "$comment": "Generator additionally rejects whitespace/control-only strings, invalid calendar dates, future modified dates, duplicate IDs, nonfolder/missing/cyclic parents and usedGB > totalGB."
}
