      "empty_state",
      "one_filled_create",
      "one_optional_text_help"
    ],
    "destructive_flow": [
      "danger_text_trigger",
      "non_dismissible_confirmation_dialog",
      "cancel_autofocus",
      "danger_filled_confirm"
    ]
  },
  "lint": {
    "command": "npm run lint:design",
    "default_target": "examples",
    "fails_on": [
      "raw colors",
      "inline styles",
      "forbidden Tailwind classes",
      "button without type",
      "icon button without aria-label",
      "div role=button",
      "image without alt",
      "multiple primary filled actions"
    ]
  }
