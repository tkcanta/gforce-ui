  "forbidden_patterns": [
    {
      "id": "raw-color",
      "pattern": "hex/rgb/hsl in HTML or arbitrary Tailwind color",
      "reason": "themeとsemantic roleを破壊する"
    },
    {
      "id": "decorative-gradient",
      "pattern": "gradient except skeleton shimmer",
      "reason": "Google Workspace/Cloud calm profileから逸脱する"
    },
    {
      "id": "glassmorphism",
      "pattern": "backdrop blur + translucent card",
      "reason": "surface hierarchyが不明確になる"
    },
    {
      "id": "oversized-shadow",
      "pattern": "shadow-lg/xl/2xl or custom dramatic shadow",
      "reason": "常設UIが浮遊して見える"
    },
    {
      "id": "random-radius",
      "pattern": "arbitrary radius or rounded-2xl/3xl on ordinary controls",
      "reason": "shape grammarが崩れる"
    },
    {
      "id": "bold-ui",
      "pattern": "font-bold/extrabold/black",
      "reason": "Google系UIの情報階層より強すぎる"
    },
    {
      "id": "pill-field",
      "pattern": "ordinary text field with full radius",
      "reason": "searchとbuttonの形状意味が失われる"
    },
    {
      "id": "card-everything",
      "pattern": "every section wrapped in card",
      "reason": "階層が均一化し情報密度が落ちる"
    },
    {
      "id": "multiple-primary",
      "pattern": "two or more filled primary buttons in one action group",
      "reason": "主要操作が判別できない"
    },
    {
      "id": "icon-only-without-name",
      "pattern": "icon button without aria-label",
      "reason": "操作名が支援技術へ伝わらない"
    },
    {
      "id": "div-button",
      "pattern": "div/span with click handler or role=button",
      "reason": "native keyboard behaviorを失う"
    },
    {
      "id": "hover-only",
      "pattern": "essential action or content only visible on hover",
      "reason": "touch/keyboardで利用できない"
    }
  ],
  "ai_page_decision_tree": {
    "dashboard": [
      "app_shell",
      "page_header",
      "optional_alert",
      "stat_grid",
      "primary_data_table_or_chart",
      "secondary_activity"
    ],
    "settings": [
      "app_shell",
      "page_header",
      "tabs_if_3_to_7_categories",
      "form_width_720",
      "cards_only_for_distinct_setting_groups",
      "bottom_action_group"
    ],
    "list_management": [
      "app_shell",
      "page_header_with_one_filled_create",
      "filter_bar",
      "list_or_table",
      "pagination",
      "side_sheet_for_contextual_edit"
    ],
    "workspace_files": ["validated_spec", "canonical_generator", "single_work_surface", "search_filters_selection", "table_or_list_by_content_width", "local_demo_states", "static_and_browser_gates"],
    "detail": [
      "breadcrumbs",
      "page_header",
      "description_list",
      "tabs_if_peer_sections",
      "danger_zone_at_end"
    ],
    "empty_first_use": [
