        "avatar": 9999
      }
    },
    "elevation": {
      "levels": {
        "0": "page, static card, list, table, field, navigation drawer",
        "1": "sticky topbar, interactive card hover",
        "2": "menu, popover, search focus, FAB",
        "3": "side sheet, snackbar",
        "dialog": "modal dialog only"
      },
      "max_simultaneous_visible_levels": 3
    },
    "motion": {
      "durations_ms": {
        "instant": 80,
        "fast": 100,
        "standard": 180,
        "slow": 260,
        "emphasis": 340
      },
      "easing": {
        "standard": "cubic-bezier(0.2,0,0,1)",
        "enter": "cubic-bezier(0,0,0,1)",
        "exit": "cubic-bezier(0.3,0,1,1)"
      },
      "component_mapping": {
        "hover": 100,
        "tabs": 180,
        "menu": 100,
        "dialog": 260,
        "side_sheet": 260,
        "snackbar": 260
      },
      "max_hover_translation_px": 0,
      "max_pressed_translation_px": 0,
      "reduced_motion_required": true
