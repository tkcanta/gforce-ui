        "icon_to_label": 8,
        "field_label_to_control": 6,
        "field_control_to_support": 6,
        "button_group_gap": 8,
        "card_padding": 16,
        "large_card_padding": 24,
        "section_heading_to_content": 16,
        "section_to_section": 48,
        "page_header_bottom": 32,
        "compact_page_gutter": 16,
        "medium_page_gutter": 24,
        "expanded_page_gutter": 32,
