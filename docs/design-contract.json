{
  "meta": {
    "name": "G-Force UI",
    "version": "1.3.0",
    "language": "ja",
    "objective": "Google WorkspaceおよびGoogle Cloud系Webアプリの視覚文法を、AIが推測せず再現できるように強制する",
    "compliance_mode": "whitelist",
    "official_google_product": false,
    "runtime": [
      "HTML5",
      "Tailwind CSS v4 compiled CSS",
      "Vanilla JavaScript ES Modules"
    ]
  },
  "profile_routing": {
    "workspace": "Existing tokens, components and page decision tree below remain unchanged",
    "landing": {"contract": "docs/landing-contract.json", "schema": "docs/landing.schema.json", "rules": "docs/current/landing.md", "generator": "tools/generate-landing.mjs", "audience_required": true},
    "mix_profiles_on_one_page": false
  },
  "non_negotiable_principles": [
    "色はsemantic tokenだけを使う。HTML内のHEX、rgb、hsl、Tailwind arbitrary colorは禁止",
    "余白はallowed_spacing_pxに含まれる値だけを使う",
    "角丸はcomponent_radius_mapに従い、デザイナーまたはAIが任意に変更しない",
    "1つのdata-gfu-action-group内にdata-variant=filledのボタンは最大1個",
    "常設カードはshadowなし。shadowはmenu、popover、dialog、side sheet、snackbarだけ",
    "検索欄だけをpill形状にする。通常入力欄をpillにしない",
    "UI本文は14px/22px/400。ボタンとラベルは14px/20px/500。700以上を使わない",
    "GradientはSkeletonのshimmer以外で使わない",
    "Icon Buttonはaria-label必須。装飾SVGはaria-hidden=true",
    "操作はbutton、移動はa、入力はinput/select/textareaを使う。div role=buttonは禁止",
    "モバイル320px幅で主要機能を失わせない",
    "ホバーだけに情報や操作を隠さない"
  ],
  "profiles": {
    "workspace-files": {
      "version": "1.2.0",
      "select_when": ["file management", "drive", "ファイル管理", "ファイル一覧"],
      "page_type": "list_management",
      "precedence": "profile-specific rules override generic page rules",
      "spec_schema": "docs/workspace-files.schema.json",
      "generator": "tools/generate-files.mjs",
      "template": "templates/workspace-files.html",
      "example": "examples/files.html",
      "consumer_css_allowed": false,
      "consumer_dom_edits_allowed": false,
      "forbidden_default_slots": ["stats", "persistent_reminder", "marketing_description", "redundant_section_heading"],
      "primary_surface_count": 1,
      "title": { "size_px": 24, "line_px": 32, "weight": 400 },
      "create": { "desktop": "left_navigation_tonal", "compact": "header_tonal", "visible_max": 1, "flow": "menu_then_name_dialog" },
      "table_min_content_width_px": 720,
      "table_row_px": 48,
      "touch_row_px": 56,
      "icon_target_px": 48,
      "page_gutter_px": 16,
      "surface_padding_desktop_px": 24,
      "first_item_max_top_px": 280,
      "viewport_min_visible_rows": { "1366x768": 6, "390x844": 4 },
      "required_states": ["normal", "selected", "no-results", "first-empty", "loading", "error"],
      "file_kind_tokens": {
        "document": { "light": "#185ABC", "dark": "#AECBFA" },
        "image": { "light": "#137333", "dark": "#81C995" },
        "pdf": { "light": "#B3261E", "dark": "#F28B82" },
        "meaning": "file identity, not success/warning/error"
      },
      "determinism": "same validated spec + recipe version + asset path => identical HTML; not arbitrary natural-language interpretation or cross-platform pixel identity"
    }
  },
