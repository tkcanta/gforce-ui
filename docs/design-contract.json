  "layout_contracts": {
    "topbar": {
      "height_px": 64,
      "brand_area": "left",
      "search_max_width_px": 720,
      "actions_area": "right",
      "border": "only when content scrolls or separation needed"
    },
    "drawer": {
      "desktop_width_px": 256,
      "large_optional_width_px": 280,
      "item_horizontal_padding_px": 16,
      "item_gap_px": 12,
      "selected_background": "primary_container"
    },
    "page_widths": {
      "form_px": 720,
      "reading_px": 768,
      "dashboard_px": 1440,
      "app_px": 1600
    },
    "page_header": {
      "eyebrow_optional": true,
      "title_required": true,
      "description_max_width_px": 768,
      "actions_max_primary": 1,
      "bottom_margin_px": 32
    },
    "section": {
      "title_to_content_px": 16,
      "section_gap_px": 48,
      "max_heading_levels": 3
    },
    "grid": {
      "min_card_width_px": 288,
      "gap_px": 16,
      "dashboard_gap_px": 24
    }
  },
  "composition_rules": {
    "action_group": {
      "filled_max": 1,
      "danger_filled_max": 1,
      "filled_and_danger_filled_same_group": false,
      "button_gap_px": 8
    },
    "card": {
      "use_when": "single object or single action unit",
      "do_not_use_for": "every section, generic spacing, page-wide grouping",
      "nested_card_max_depth": 1
    },
    "search": {
      "height_px": 48,
      "radius": 9999,
      "background": "surface_container",
      "border_default": "transparent",
      "max_width_px": 720
    },
    "floating": {
      "components": ["gfu-menu", "gfu-popover"],
      "visibility_owner": "library CSS and JavaScript",
      "initial_data_open": "false",
      "recommended_initial_hidden_attribute": false,
      "legacy_initial_hidden_attribute_supported": true,
      "open_sequence": ["beforeopen event", "close previous panel", "remove initial hidden attribute", "set closed state", "position and flush closed layout", "set open state", "focus and open event"],
      "consumer_must_not_toggle": ["hidden", "display", "opacity", "visibility", "transform"],
      "forbidden_classes": ["hidden including responsive variants", "transition-none", "animate-none", "duration-0"],
      "motion_override_exception": "prefers-reduced-motion / motion-reduce variants",
      "first_and_subsequent_open_motion_required": true,
      "regression_command": "npm run test:browser"
    },
    "forms": {
      "label_always_visible": true,
      "placeholder_as_label": false,
      "field_spacing_px": 16,
      "form_section_gap_px": 32,
      "submit_position": "bottom-right desktop; full-width mobile optional"
    },
    "tables": {
      "header_height_by_density": true,
      "numeric_align": "right",
      "text_align": "left",
      "row_actions_max": 2,
      "horizontal_scroll_only_when_two_dimensional_structure_requires_it": true
    },
    "icons": {
      "allowed_sizes_px": [
        16,
        20,
        24,
        32
      ],
      "default_px": 20,
      "navigation_px": 24,
      "mixed_styles_same_screen": false,
      "icon_button_label_required": true
    },
    "content": {
      "button_text": "verb-first",
      "sentence_case": true,
      "generic_ok_ng": false,
      "error_message_requires_repair_instruction": true
    }
  },
  "dropdown_contract": {
    "root": ".gfu-dropdown[data-gfu-dropdown]",
    "source": "one flat, single select with id and a visible label[for]; keep native name/value/options",
    "generated_dom_owner": "library only; do not author trigger or listbox",
    "role": "select-only combobox + top-layer listbox",
    "forbidden": ["OS-native select popup in initialized UI", "select outside canonical Dropdown", "gfu-field__select", "gfu-select-wrap", "hand-authored dropdown trigger/arrow/listbox", "value and arrow on different lines", "arrow wrapping/overlap/disappearance"],
    "trigger_layout": "single row, vertically centered; arrow fixed at trailing edge; only value ellipsizes",
    "enforcement": ["GFU028: native/legacy select markup", "GFU029: hand-authored generated DOM", "browser: no visible select and value/arrow geometry at 320/390/1366px"],
    "focus_border": "one 2px primary stroke around the whole trigger; no inner select outline",
    "trigger_height_px": { "default": 44, "compact_density": 36, "touch_or_mobile": 48 },
    "option_min_height_px": { "desktop": 40, "touch_or_mobile": 48 },
    "popup": { "radius_px": 12, "shadow": 2, "border_px": 0, "viewport_gutter_px": 8, "max_height_px": 384, "placement": "below start; flip above when needed" },
    "keyboard": ["arrows", "home/end", "page up/down", "typeahead", "enter/space commit", "tab commit and advance", "escape cancel"],
    "states": ["closed", "open", "active", "selected checkmark", "disabled", "required invalid", "reset", "light", "dark", "reduced motion"],
    "change_contract": "native select input/change once per changed choice; programmatic .value then GForceUI.dropdown.sync(select)",
    "unsupported": ["multiple", "optgroup", "editable search"]
  },
